# Required: Google Gemini API key (free tier or Google Cloud project)
# Create one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: Google Maps JavaScript API key (for the React map UI).
# If left empty, the map automatically falls back to OpenStreetMap via React Leaflet.
GOOGLE_MAPS_API_KEY=

# Optional overrides (defaults are defined in src/config.py)
# LLM_MODEL=gemini-3.5-flash-lite
# CONDENSE_LLM_MODEL=gemini-3.1-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=6
# SCORE_THRESHOLD=0.65
# MAX_HISTORY_TURNS=6
